{
  "name": "rms-next-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start source .env",
    "dev:https": "concurrently \"pnpm run ssl-proxy\" \"pnpm run dev\"",
    "ssl-proxy": "source .env && local-ssl-proxy --key ${SSL_KEY_FILE} --cert ${SSL_CERT_FILE} --source 6007 --target 6006",
    "prepare": "is-ci || husky install",
    "format": "prettier . --write",
    "lint:js": "eslint . --fix --cache",
    "lint:css": "stylelint \"**/*.scss\"",
    "type-check": "tsc",
    "check-all": "pnpm run type-check && pnpm run lint:js && pnpm run lint:css"
  },
  "dependencies": {
    "@rms-forge/ui": "2.3.0",
    "@rms-forge/ui-design-tokens": "2.3.0",
    "@rms-forge/ui-text": "2.4.0",
    "@types/node": "^20.17.30",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "classnames": "^2.5.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^13.5.11",
    "next": "^15.3.0",
    "next-build-id": "^3.0.0",
    "next-compose-plugins": "^2.2.1",
    "next-transpile-modules": "^10.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sass": "^1.86.3",
    "typescript": "^5.8.3",
    "ua-parser-js": "^1.0.40",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@types/lodash": "^4.17.16",
    "@types/node": "^16.18.36",
    "@types/nodemailer": "^6.4.17",
    "@types/prettier": "^2.7.3",
    "@types/react": "^17.0.62",
    "@types/react-dom": "^17.0.20",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-loader": "^9.2.1",
    "babel-plugin-transform-import-meta": "^2.3.2",
    "babel-plugin-transform-imports": "^2.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.42.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "^13.4.7",
    "eslint-config-prettier": "^8.10.0",
    "eslint-config-react": "^1.1.7",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-storybook": "^0.6.15",
    "husky": "^8.0.3",
    "is-ci": "^3.0.1",
    "lint-staged": "^13.3.0",
    "prettier": "^2.8.8",
    "sass-loader": "^13.3.3",
    "stylelint": "^15.11.0",
    "stylelint-config-standard-scss": "^10.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^4.9.5",
    "typescript-plugin-css-modules": "^5.1.0"
  },
  "volta": {
    "node": "^16.13.0"
  }
}
